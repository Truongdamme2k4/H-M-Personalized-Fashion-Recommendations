# Sử dụng bản Airflow cuối cùng còn hỗ trợ Python 3.7
FROM apache/airflow:2.6.3-python3.7
USER root

# Cài đặt Java 8 từ kho Corretto (vì Debian bản cũ cũng khó tìm Java 8)
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg && apt-get clean
RUN curl -s https://apt.corretto.aws/corretto.key | gpg --dearmor -o /usr/share/keyrings/corretto-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/corretto-keyring.gpg] https://apt.corretto.aws stable main" | tee /etc/apt/sources.list.d/corretto.list

RUN apt-get update \
    && apt-get install -y --no-install-recommends java-1.8.0-amazon-corretto-jdk \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-1.8.0-amazon-corretto
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow

# Cài đặt thư viện (Lưu ý: version các provider có thể phải hạ xuống để hợp với Airflow 2.6)
RUN pip install --no-cache-dir --default-timeout=1000 \
    apache-airflow-providers-apache-spark==4.0.0 \
    pyspark==3.1.1 \
    pymongo \
    lightgbm==3.3.5 \
    pandas==1.3.5 \
    pyarrow==12.0.1 \
    numpy==1.21.6