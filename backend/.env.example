PORT=4100
DATA_DIR=../
CORS_ORIGIN=http://localhost:5173
IMAGE_BASE=/images

# MongoDB — backend reads user_recommendations, global_trending, articles,
# similar_products, cart_recommendations from here. Pipeline (Airflow) writes
# user_recommendations + global_trending + age_bestsellers; the rest are
# seeded from local files on first boot if the collection is empty.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=hm_recsys

# Optional: signed URL template for real H&M images (Kaggle GCS).
# Use {folder} and {id} placeholders. If empty, falls back to Unsplash.
# Note: signed URL expires — refresh from Kaggle when it does.
# IMAGE_TEMPLATE=https://storage.googleapis.com/kagglesdsdata/competitions/31254/3103714/images/{folder}/{id}.jpg?X-Goog-Algorithm=...
